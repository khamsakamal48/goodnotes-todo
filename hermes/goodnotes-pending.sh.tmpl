#!/usr/bin/env bash
# Monitor for the "GoodNotes to To Do" Hermes cron job (generated by install.sh).
# Prints one stable line per page that needs reading (notebook|page|hash) and
# nothing when there is nothing new, so Hermes skips the model run entirely.
# On failure it prints a short, readable reason to stderr and exits non-zero.
cd "{{PROJECT_DIR}}" || { echo "GoodNotes sync: project folder missing: {{PROJECT_DIR}}" >&2; exit 1; }

fail() { echo "GoodNotes sync failed: $*" >&2; exit 1; }

err="$(mktemp)"; trap 'rm -f "$err"' EXIT
if ! out="$(.venv/bin/python bin/notesync.py pending 2>"$err")"; then
  msg="$(cat "$err")"
  remote="$(printf '%s' "$msg" | sed -n 's/.*file system for "\([^":]*\):.*/\1/p' | head -n1)"
  case "$msg" in
    *"no refresh token"*|*"token expired"*|*invalid_grant*|*"couldn't fetch token"*)
      fail "Google Drive sign-in expired. Run: rclone config reconnect ${remote:-<remote>}:  (then check 'rclone config show ${remote:-<remote>}' has a refresh_token)" ;;
    *"command failed: rclone"*)
      fail "rclone error: $(printf '%s' "$msg" | grep -m1 -E 'CRITICAL|ERROR' | sed 's/^[0-9/ :]*//')" ;;
    *)
      fail "$(printf '%s' "$msg" | tail -n1)" ;;
  esac
fi

printf '%s' "$out" | .venv/bin/python -c '
import json, sys
try:
    pages = json.load(sys.stdin)
except ValueError:
    sys.exit("GoodNotes sync failed: notesync.py pending did not return JSON")
for p in pages:
    print("%s|%s|%s" % (p["notebook"], p["page"], p["hash"][:16]))'
